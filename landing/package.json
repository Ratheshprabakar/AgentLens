{
  "name": "agentlens-landing",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm run sync:install; vite",
    "build": "pnpm run sync:install; tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:install": "node -e \"try{require('fs').copyFileSync('../scripts/install.sh','public/install.sh');console.log('synced public/install.sh')}catch(e){console.log('using committed public/install.sh')}\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
