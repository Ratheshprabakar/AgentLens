{
  "name": "agentlens",
  "version": "1.0.0",
  "description": "DevTools for AI coding agents - records every observable action and turns it into an interactive timeline",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "agentlens": "./dist/cli.js"
  },
  "scripts": {
    "build:web": "vite build",
    "build:cli": "bun build src/cli.ts --target=node --outfile dist/cli.js --banner '#!/usr/bin/env node'",
    "build": "pnpm run build:web && pnpm run build:cli",
    "build:landing": "pnpm --filter agentlens-landing build",
    "prepublishOnly": "pnpm run build",
    "dev": "pnpm run dev:server & pnpm run dev:web",
    "dev:server": "bun --watch src/cli.ts start --dev",
    "dev:web": "vite",
    "dev:landing": "pnpm --filter agentlens-landing dev",
    "start": "bun src/cli.ts start",
    "install-hooks": "bun src/cli.ts install",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "scripts/install.sh",
    "docker-compose.prod.yml",
    ".env.example"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "open": "^10.1.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.2",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "framer-motion": "^13.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "typescript": "^5.4.2",
    "vite": "^5.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "ai",
    "devtools",
    "claude",
    "observability",
    "agent",
    "timeline"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ratheshprabakar/AgentLens",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ratheshprabakar/AgentLens.git"
  }
}
