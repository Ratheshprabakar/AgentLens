{
  "name": "agentlens",
  "version": "0.1.0",
  "description": "DevTools for AI coding agents — records every observable action and turns it into an interactive timeline",
  "type": "module",
  "bin": {
    "agentlens": "./dist/cli.js",
    "agentlens-hook": "./dist/hooks/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/cli.ts start --dev",
    "dev:web": "vite",
    "start": "node dist/cli.js start",
    "install-hooks": "node dist/cli.js install",
    "clean": "rm -rf dist dist-web"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "open": "^10.1.0",
    "pg": "^8.23.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
