# AgentLens environment variables
# Copy to .env and edit as needed

# Port exposed on the host (default: 4040)
PORT=4040

# Path to Claude Code projects directory on your machine
CLAUDE_PROJECTS_DIR=~/.claude/projects

# Path to Cursor projects directory (agent-transcripts live under each project)
CURSOR_PROJECTS_DIR=~/.cursor/projects

# PostgreSQL connection string (used inside the container)
# Don't change this unless you bring your own Postgres
DATABASE_URL=postgresql://agentlens:agentlens@postgres:5432/agentlens
